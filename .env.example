# ══════════════════════════════════════════════════════════════
#  Vercel → Settings → Environment Variables ga qo'shing
# ══════════════════════════════════════════════════════════════

# Google Apps Script (Sheets) web ilova URL manzili — ma'lumotlar bazasi
GAS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Google Apps Script bilan Vercel o'rtasidagi maxfiy kalit.
# google-apps-script.js dagi ADMIN_SECRET bilan BIR XIL bo'lishi SHART.
# Uzun tasodifiy satr qo'ying (masalan: openssl rand -hex 24)
GAS_ADMIN_SECRET=uzun-tasodifiy-maxfiy-kalit

# Sessiya (JWT) imzolash kaliti — uzun tasodifiy satr
JWT_SECRET=yana-bir-uzun-tasodifiy-kalit

# Admin panelga (admin.html) kirish paroli
ADMIN_PASSWORD=admin-paroli-shu-yerda
