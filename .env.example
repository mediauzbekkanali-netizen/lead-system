# ══════════════════════════════════════════════════════════════
#  Netlify → Site settings → Environment variables ga qo'shing
# ══════════════════════════════════════════════════════════════

# Google Apps Script (Sheets) web-ilova URL — ma'lumotlar bazasi
GAS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# GAS bilan server o'rtasidagi maxfiy kalit
# (google-apps-script.js dagi ADMIN_SECRET bilan BIR XIL bo'lishi SHART)
GAS_ADMIN_SECRET=uzun-tasodifiy-maxfiy-kalit

# JWT (sessiya) imzolash kaliti — uzun tasodifiy satr
JWT_SECRET=yana-bir-uzun-tasodifiy-kalit

# Administrator paroli (login har doim: globaltargeting)
ADMIN_PASSWORD=admin-uchun-kuchli-parol
